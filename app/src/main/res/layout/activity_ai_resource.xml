<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/back"
            app:tint="@color/black"/>

        <!-- Header: Original Document Title -->
        <TextView
            android:id="@+id/resourceTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Flashcard: Machine Learning Basics"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:textStyle="bold"
            android:textColor="#212121" />

        <TextView
            android:id="@+id/uploaderName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Uploaded by: @elkamira"
            android:textColor="#757575"
            android:layout_marginTop="4dp"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Original Resource Info -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Original Resource"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/book"
                android:contentDescription="File" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp">

                <TextView
                    android:id="@+id/originalFileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="document.pdf"
                    android:textColor="#000000"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/originalFileSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2.3 MB"
                    android:textSize="13sp"
                    android:textColor="#757575" />
            </LinearLayout>


        </LinearLayout>

        <!-- Flashcard Section -->
        <LinearLayout
            android:id="@+id/flashcard_section"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_flashcard_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Flashcard 1 of 10"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:layout_gravity="center_horizontal" />

            <TextView
                android:id="@+id/tv_flashcard_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Flashcard content goes here..."
                android:paddingTop="12dp"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_prev_flashcard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/primary"
                    android:text="Previous" />

                <Space
                    android:layout_width="16dp"
                    android:layout_height="0dp" />

                <Button
                    android:id="@+id/btn_next_flashcard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/primary"
                    android:text="Next" />
            </LinearLayout>
        </LinearLayout>

        <!-- Quiz Room Section -->
        <LinearLayout
            android:id="@+id/quiz_section"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_quiz_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Questions: 10 | Attempts: 3 | Highest Score: 8"
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_start_quiz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/primary"
                android:text="Start Quiz" />
        </LinearLayout>

        <!-- Summary Section -->
        <LinearLayout
            android:id="@+id/summary_section"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_summary_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Summary preview goes here..."
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_download_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/primary"
                android:text="Download Summary" />
        </LinearLayout>

        <!-- Transcription Section -->
        <LinearLayout
            android:id="@+id/transcription_section"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_transcribed_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Transcribed text goes here..."
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_download_transcription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/primary"
                android:text="Download Transcription" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
