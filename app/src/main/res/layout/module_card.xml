<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="8dp"
    android:layout_height="wrap_content"
    android:elevation="4dp"
    android:padding="12dp">

    <LinearLayout
        android:orientation="vertical"
        android:padding="10sp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Module Title and Edit Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >

            <TextView
                android:id="@+id/moduleTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Module 1: Front-End Fundamentals"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_height="wrap_content" />

            <ImageView
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/edit"
                app:tint="@color/textcolor"
                android:contentDescription="Edit module" />
            <ImageView
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/delete"
                app:tint="@color/textcolor"
                android:contentDescription="delete module" />
        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/moduleDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Covering HTML5, CSS3, and core JavaScript concepts, building interactive user interfaces."
            android:textSize="16sp"
            android:layout_marginTop="4dp"/>

        <!-- Tasks -->
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:text="Tasks:"
                android:textStyle="bold"
                android:textSize="17sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <ImageView
                android:id="@+id/chevron"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/chevron_down"/>
        </RelativeLayout>


        <!-- Example Task -->
        <LinearLayout
            android:visibility="gone"
            android:id="@+id/tasks"
            android:layout_marginTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >


        </LinearLayout>



    </LinearLayout>
</androidx.cardview.widget.CardView>
